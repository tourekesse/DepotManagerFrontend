{
  "name": "material-ui-vite",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "node scripts/build-mobile.js",
    "build:analyze": "vite build --mode production --analyze",
    "build:production": "npm run build:mobile && npm run optimize:images",
    "optimize:images": "node scripts/optimize-images.js",
    "serve": "vite preview",
    "generate:api": "openapi --input openapi.json --output src/api",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "bundle-size": "npm run build:mobile && node scripts/check-bundle-size.js",
    "performance:mobile": "npm run build:mobile && npm run lighthouse"
  },
  "dependencies": {
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.10.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "latest",
    "@mui/x-charts": "^8.27.0",
    "@mui/x-data-grid": "^8.22.0",
    "@mui/x-date-pickers": "^8.22.0",
    "axios": "^1.13.2",
    "chromedriver": "^146.0.0",
    "dayjs": "^1.11.19",
    "firebase": "^12.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "puppeteer": "^25.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.4.23",
    "brotli-size": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "cssnano": "^7.1.2",
    "gzip-size": "^7.0.0",
    "image-webpack-loader": "^8.1.0",
    "jsdom": "^27.4.0",
    "openapi-typescript-codegen": "^0.29.0",
    "rollup-plugin-visualizer": "^5.9.0",
    "selenium-webdriver": "^4.46.0",
    "terser": "^5.19.0",
    "vite": "latest",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.16",
    "webpack-bundle-analyzer": "^4.9.0",
    "workbox-webpack-plugin": "^7.0.0"
  }
}
