// Package.json scripts pour optimisation mobile
// Ajouter ces scripts à votre package.json

{
  "name": "depotmanager-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "react-router-dom": "^6.8.0",
    "@tanstack/react-query": "^4.29.0",
    "web-vitals": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0",
    "terser": "^5.19.0",
    "compression-webpack-plugin": "^10.0.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "image-webpack-loader": "^8.1.0",
    "gzip-size": "^7.0.0",
    "brotli-size": "^4.0.0",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "node scripts/build-mobile.js",
    "build:analyze": "vite build --mode production --analyze",
    "build:production": "npm run build:mobile && npm run optimize:images",
    "optimize:images": "node scripts/optimize-images.js",
    "serve": "vite preview",
    "test": "vitest",
    "test:mobile": "vitest --config vitest.mobile.config.js",
    "lighthouse": "lhci autorun && lhci upload",
    "bundle-size": "npm run build:mobile && node scripts/check-bundle-size.js",
    "performance:mobile": "npm run build:mobile && npm run lighthouse"
  }
}
